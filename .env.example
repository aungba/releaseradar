# Copy to .env and adjust. Used by docker-compose and the backend (pydantic-settings).

# --- Backend ---
RR_ENVIRONMENT=development
RR_DATABASE_URL=postgresql+asyncpg://releaseradar:releaseradar@localhost:5432/releaseradar
RR_REDIS_URL=redis://localhost:6379/0
# Generate with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
RR_ENCRYPTION_KEY=
RR_CORS_ORIGINS=["http://localhost:5173"]

# --- LLM (used from M2) ---
RR_LLM_PRIMARY_MODEL=gemini/gemini-2.5-pro
RR_LLM_FALLBACK_MODEL=groq/llama-3.3-70b-versatile
GEMINI_API_KEY=
GROQ_API_KEY=
